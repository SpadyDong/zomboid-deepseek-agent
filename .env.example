# ===== DeepSeek 官方 API 配置 =====
# 使用方法：复制本文件为 .env 并填入真实值：cp .env.example .env
# 警告：.env 已被 .gitignore 忽略，请切勿把真实密钥提交到仓库！

# DeepSeek API 密钥（必填，申请地址：https://platform.deepseek.com/api_keys）
DEEPSEEK_API_KEY=sk-在此填入你的密钥

# DeepSeek API 地址（可选，一般无需修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名称（可选，默认 deepseek-chat；也可按官方文档改为 deepseek-flash / deepseek-v4-pro）
DEEPSEEK_MODEL=deepseek-chat

# PZ 用户目录下的 Zomboid/Lua 绝对路径（可选，不填则按操作系统自动探测）
# Windows 示例：PZ_IPC_DIR=C:\Users\你的用户名\Zomboid\Lua
# Linux/macOS 示例：PZ_IPC_DIR=/home/你的用户名/Zomboid/Lua
# PZ_IPC_DIR=
